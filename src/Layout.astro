---
import "@styles/styles.scss";
import type { TemplateConfig } from "utils/configType";

const { backgroundGrid, seo, logo, theme, forceTheme, appStoreLink, name, home, appStore } =
  Astro.props as TemplateConfig;

// Optional overrides so nested layouts (e.g. BlogLayout) can supply their own
// breadcrumb trail and inject extra @graph nodes, keeping Layout the single
// place that renders JSON-LD (avoids duplicate/conflicting @id entities).
const { breadcrumbOverride, extraGraphNodes, noindex, ogImageOverride } = Astro.props as {
  breadcrumbOverride?: any[];
  extraGraphNodes?: any[];
  noindex?: boolean;
  ogImageOverride?: string;
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.href ?? "https://event-stories.12f.dk/";
// Nested layouts (e.g. blog posts) can supply their own social image via
// `ogImageOverride` (the post cover); everything else uses the site card.
const ogImage = ogImageOverride ?? new URL("/og-image.png", Astro.site).href;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

// Ratings come from the live App Store lookup and are only ever emitted when
// they actually exist. Never synthesise a fallback: publishing an
// `aggregateRating` the store cannot corroborate is fake-review markup under
// Google's structured-data policy, and it costs us the trust signal that AI
// answer engines weigh most heavily. No ratings yet => no rating node.
const hasRealRating =
  !!appStore && appStore.rating > 0 && appStore.ratingCount > 0;
const appVersion = appStore?.version ?? "1.0";
const appDescription = appStore?.description ?? seo.description;
const datePublished = appStore?.lastUpdated?.slice(0, 10) ?? "2025-01-01";
const iosRequirement = appStore?.minimumOsVersion ?? "17.0";

const screenshotURLs = home?.header?.screenshots?.map(s =>
  s.startsWith("http") ? s : new URL(s, Astro.site).href
) ?? [];

// Breadcrumb list (only shown for non-home pages).
// A nested layout can pass a full trail via `breadcrumbOverride`.
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = breadcrumbOverride ?? [
  { "@type": "ListItem", position: 1, name: "Home", item: siteURL }
];
if (!breadcrumbOverride && !isHome && pathSegments.length > 0) {
  // Trim the site-name suffix whether joined with " - " or an em/en-dash.
  const title = seo.title.split(/\s[—–-]\s/)[0];
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: title,
    item: canonicalURL.href,
  });
}

// Build consolidated @graph so each entity has a stable @id and can cross-reference.
const graph: any[] = [
  {
    "@type": "Organization",
    "@id": `${siteURL}#organization`,
    name: "12f",
    url: "https://www.12f.dk",
    logo: new URL("/logo.png", Astro.site).href,
    sameAs: [
      "https://apps.apple.com/dk/app/event-stories-party-planner/id6755695151",
      "https://www.12f.dk",
    ],
    contactPoint: {
      "@type": "ContactPoint",
      email: "robert@12f.dk",
      contactType: "customer support",
    },
    founder: {
      "@type": "Person",
      name: "Robert Jensen",
    },
  },
  {
    "@type": "WebSite",
    "@id": `${siteURL}#website`,
    name,
    url: siteURL,
    description: seo.description,
    publisher: { "@id": `${siteURL}#organization` },
    inLanguage: "en",
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalURL.href}#webpage`,
    url: canonicalURL.href,
    name: seo.title,
    description: seo.description,
    isPartOf: { "@id": `${siteURL}#website` },
    inLanguage: "en",
    breadcrumb: { "@id": `${canonicalURL.href}#breadcrumb` },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL.href}#breadcrumb`,
    itemListElement: breadcrumbItems,
  },
];

// Extra nodes supplied by a nested layout (e.g. a blog Article).
if (extraGraphNodes?.length) {
  graph.push(...extraGraphNodes);
}

if (isHome) {
  graph.push({
    "@type": "MobileApplication",
    "@id": `${siteURL}#app`,
    name: "Event Stories: Party Planner",
    alternateName: "Event Stories",
    operatingSystem: `iOS ${iosRequirement}+`,
    applicationCategory: "LifestyleApplication",
    applicationSubCategory: "Event Planning",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
    },
    ...(hasRealRating && {
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: String(appStore!.rating),
        ratingCount: String(appStore!.ratingCount),
        bestRating: "5",
        worstRating: "1",
      },
    }),
    description: appDescription,
    url: siteURL,
    downloadUrl: appStoreLink,
    installUrl: appStoreLink,
    screenshot: screenshotURLs,
    image: screenshotURLs[0],
    author: { "@type": "Person", name: "Robert Jensen" },
    publisher: { "@id": `${siteURL}#organization` },
    softwareVersion: appVersion,
    datePublished,
    dateModified: datePublished,
    inLanguage: "en",
    featureList: [
      "Guest List Management with RSVP Tracking",
      "Event Budget Tracking with Visual Charts",
      "Schedule & Timeline Planning",
      "Vendor Contact & Contract Management",
      "Professional PDF Report Export",
      "iCloud Sync Across Apple Devices",
      "Offline Support",
      "Photo Documentation",
      "Task Management & Checklists",
    ],
    keywords:
      "event planner, party planner, wedding planner, guest list, budget tracker, RSVP, vendor management, event timeline",
    audience: {
      "@type": "Audience",
      audienceType:
        "Event hosts, wedding planners, corporate event organizers, party hosts",
    },
    // Deliberately no `review` array. The testimonials in config are marketing
    // copy, not verifiable first-party reviews, so marking them up as `Review`
    // nodes would be self-serving review markup. They stay as visible page
    // content; only real App Store reviews would belong here.
  });

  if (home?.faq?.qa?.length) {
    graph.push({
      "@type": "FAQPage",
      "@id": `${siteURL}#faq`,
      mainEntity: home.faq.qa.map(item => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    });
  }

  if (home?.howItWorks?.steps?.length) {
    graph.push({
      "@type": "HowTo",
      "@id": `${siteURL}#howto`,
      name: "How to plan your event with Event Stories",
      description:
        "Plan your perfect event from start to finish with the Event Stories iPhone app.",
      totalTime: "PT10M",
      step: home.howItWorks.steps.map((step, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: step.title,
        text: step.subtitle,
        image: step.image.startsWith("http")
          ? step.image
          : new URL(step.image, Astro.site).href,
      })),
    });
  }

  if (home?.features?.cards?.length) {
    graph.push({
      "@type": "ItemList",
      "@id": `${siteURL}#features`,
      name: home.features.title,
      description: home.features.subtitle,
      itemListElement: home.features.cards.map((card, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: card.title,
        description: card.subtitle,
      })),
    });
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- The only header from the old (inert) public/_headers file that a static
         page can set for itself. The rest need edge rules — see
         docs/HOSTING-HEADERS.md. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {logo.startsWith("http") && <link rel="apple-touch-icon" href={logo} />}
    <meta name="generator" content={Astro.generator} />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preload critical above-fold image (first screenshot) - responsive -->
    <link rel="preload" href="/screenshots/projects-list-mobile.webp" as="image" type="image/webp" media="(max-width: 768px)" />
    <link rel="preload" href="/screenshots/projects-list.webp" as="image" type="image/webp" media="(min-width: 769px)" />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://umami.robert-jensen.dk" />
    <link rel="dns-prefetch" href="https://apps.apple.com" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Sitemap & AI Crawler Hints -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Information" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Information (Detailed)" />
    <link rel="author" type="text/plain" href="/humans.txt" />

    <!-- Language -->
    <meta http-equiv="content-language" content="en" />

    <!-- Primary Meta Tags -->
    <title>{seo.title}</title>
    <meta name="title" content={seo.title} />
    <meta name="description" content={seo.description} />
    <meta name="keywords" content="event planner app, party planner app, wedding planner, guest list manager, event budget tracker, RSVP tracker, event planning app, party organizer, iOS event app, iPhone party planner, event timeline, vendor management, celebration planner, birthday party planner, event coordination, event management app, free event planner, wedding budget tracker, party guest list, event schedule app, vendor management app" />
    <meta name="author" content="Robert Jensen" />
    <meta name="publisher" content="12f" />
    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}
    <meta name="bingbot" content="index, follow" />
    <meta name="rating" content="General" />
    <meta name="category" content="Productivity, Lifestyle, Event Planning" />

    <!-- Apple App Store Smart Banner -->
    <meta name="apple-itunes-app" content="app-id=6755695151" />
    <meta name="apple-mobile-web-app-title" content="Event Stories" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="qIt43wKbCVGfZYBrH1zV-3NRdMEtU0fo9qT-7NBC4n8" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Event Stories - Party Planner app for iPhone showing guest lists, budget tracking, and event schedules" />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Event Stories - Party Planner app for iPhone" />

    <!-- Consolidated Structured Data (@graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline define:vars={{ forceTheme }}>
      function getPreferredColorScheme() {
        if (!window.matchMedia) {
          return;
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
      }
      const theme = localStorage.getItem("theme") ?? getPreferredColorScheme();
      if (theme === "dark" && !forceTheme)
        document.documentElement.setAttribute("data-theme", theme);
    </script>

    <!-- Umami Analytics -->
    <script defer src="https://umami.robert-jensen.dk/script.js" data-website-id="0df3d4bd-48ba-46d8-b04c-bfee9f848988"></script>
  </head>
  <body class="relative">
    {backgroundGrid && <div class="backgroundGrid" />}
    <slot />
  </body>
</html>
