---
import Layout from "../Layout.astro";
import { SiteNavbar, SiteFooter } from "@components/siteChrome";
import defaultTemplateConfig from "utils/config";
import { fetchAppStoreData, fallbackAppStoreData, toAppStoreMetadata } from "utils/appStoreData";
import type { TemplateConfig } from "utils/configType";

const {
  title,
  description,
  ogImage: providedOgImage,
  canonicalPath,
  articleSchema,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

const ogImage = providedOgImage?.startsWith("http")
  ? providedOgImage
  : `${Astro.site}${providedOgImage}`;

const canonicalURL = canonicalPath
  ? new URL(canonicalPath, Astro.site)
  : Astro.url;

const appStoreData = await fetchAppStoreData() ?? fallbackAppStoreData;
const seo = {
  title: title ?? "Blog — Event Stories: Party Planner",
  description: description ?? "Tips and guides for planning memorable events.",
};

const blogOgImage = providedOgImage ?? (canonicalPath ? `/og${canonicalPath.replace(/\/$/, "")}.png` : null);
const resolvedOgImage = blogOgImage && blogOgImage.startsWith("http")
  ? blogOgImage
  : blogOgImage
    ? new URL(blogOgImage, Astro.site).href
    : defaultTemplateConfig.logo;

const config: TemplateConfig = {
  ...defaultTemplateConfig,
  seo,
  logo: appStoreData.artworkUrl512.startsWith("http")
    ? appStoreData.artworkUrl512
    : defaultTemplateConfig.logo,
  appStore: toAppStoreMetadata(appStoreData),
};

// Blog article schema. Layout renders the shared @graph (Organization,
// WebSite, WebPage, BreadcrumbList); we only supply the blog-specific
// breadcrumb trail and the Article node so a single JSON-LD block is emitted
// per page (no duplicate/conflicting @id entities). See issue #31.
const articleNode = articleSchema ?? ({
  "@type": "Article",
  headline: seo.title,
  description: seo.description,
  image: resolvedOgImage,
  datePublished: publishedTime,
  dateModified: modifiedTime || publishedTime,
  author: author ? {
    "@type": "Person",
    name: author,
    url: "https://www.12f.dk",
  } : undefined,
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  keywords: tags?.join(", "),
  inLanguage: "en",
  isPartOf: {
    "@type": "Blog",
    name: "Event Stories Blog",
    url: new URL("/blog/", Astro.site).href,
  },
} as Record<string, unknown>);

// Full breadcrumb trail: Home › Blog › [Post title].
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: Astro.site },
  { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
];
if (seo.title) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 3,
    name: seo.title.split(" - ")[0],
    item: canonicalURL.href,
  });
}
---

<Layout
  {...config}
  breadcrumbOverride={breadcrumbItems}
  extraGraphNodes={[articleNode]}
>
  <SiteNavbar client:load config={config} />
  <div class="max-w-3xl mx-auto px-4 py-10 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-base-content/60">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href="/blog/" class="hover:text-primary">Blog</a>
    </nav>

    <article>
      <header class="mb-8">
        <h1 class="mb-4 text-3xl font-bold leading-tight md:text-5xl">
          <slot name="title" />
        </h1>
        <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/60">
          <slot name="author-meta" />
        </div>
        <slot />
      </header>

      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-h2:mt-12 prose-h2:text-3xl prose-h3:text-xl prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
        <slot name="content" />
      </div>
    </article>
  </div>
  <SiteFooter client:load config={config} />
</Layout>