---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props as Props;
const { Content } = await post.render();
const { minutes } = readingTime(post.body);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const canonicalPath = `/blog/${post.slug}/`;
const ogImage = post.data.ogImage ?? null;
const related = (
  post.data.relatedSlugs && post.data.relatedSlugs.length > 0
    ? allPosts.filter((p) => post.data.relatedSlugs.includes(p.slug))
    : allPosts.filter((p) => p.slug !== post.slug).slice(0, 3)
).slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: ogImage ? (ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href) : undefined,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author,
    url: "https://www.12f.dk",
  },
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(canonicalPath, Astro.site).href,
  },
  keywords: [post.data.keyword, ...(post.data.tags || [])].join(", "),
  inLanguage: "en",
  isPartOf: {
    "@type": "Blog",
    name: "Event Stories Blog",
    url: new URL("/blog/", Astro.site).href,
  },
};
---

<BlogLayout
  title={post.data.title + " — Event Stories: Party Planner"}
  description={post.data.description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  articleSchema={articleSchema}
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={post.data.updatedDate ? post.data.updatedDate.toISOString() : undefined}
  author={post.data.author}
  tags={[post.data.keyword, ...(post.data.tags || [])]}
>
  <!--title slot-->
  <div slot="title">{post.data.title}</div>

  <!--author-meta slot-->
  <div slot="author-meta" class="flex flex-wrap items-center gap-2 text-sm text-base-content/60">
    <span>By {post.data.author}</span>
    <span aria-hidden="true"> · </span>
    <time datetime={post.data.publishDate.toISOString()}>
      {formatDate(post.data.publishDate)}
    </time>
    {post.data.updatedDate && (
      <>
        <span aria-hidden="true"> · </span>
        <span>Updated {formatDate(post.data.updatedDate)}</span>
      </>
    )}
    <span aria-hidden="true"> · </span>
    <span>{minutes} min read</span>
  </div>

  <!-- content slot -->
  {post.data.lede && (
    <p class="mt-6 text-lg leading-relaxed text-base-content/85 md:text-xl" data-speakable>
      {post.data.lede}
    </p>
  )}
  <div class="prose prose-lg max-w-none prose-headings:font-bold prose-h2:mt-12 prose-h2:text-3xl prose-h3:text-xl prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
    <Content />
  </div>

  {
    related.length > 0 && (
      <aside class="mt-16 border-t border-base-300 pt-10" aria-label="Related posts">
        <h2 class="mb-6 font-display text-2xl font-bold tracking-tight">Related posts</h2>
        <ul class="grid list-none gap-4 p-0 sm:grid-cols-2">
          {related.map((p) => (
            <li class="m-0 p-0">
              <a
                href={`/blog/${p.slug}/`}
                class="group flex h-full flex-col rounded-box border border-base-300 bg-base-100 p-5 no-underline transition-colors hover:border-base-content/30"
              >
                <span class="font-display text-lg font-bold leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary">
                  {p.data.title}
                </span>
                <span class="mt-2 text-sm leading-relaxed text-base-content/70">
                  {p.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</BlogLayout>