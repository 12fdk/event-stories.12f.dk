---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props as Props;
const { Content } = await post.render();
const { minutes } = readingTime(post.body);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const canonicalPath = `/blog/${post.slug}/`;
const canonicalHref = new URL(canonicalPath, Astro.site).href;
// Fall back to the post's real cover image (which exists in public/blog/)
// before giving up — never point at a non-existent /og/*.png file (issue #34).
const ogImage = post.data.ogImage ?? post.data.cover ?? null;
// Start from the curated relatedSlugs, then top up with other recent posts so
// the "Keep reading" row always shows up to three cards.
const relatedBySlug = (post.data.relatedSlugs ?? [])
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is (typeof allPosts)[number] => Boolean(p) && p!.slug !== post.slug);

const fillers = allPosts
  .filter((p) => p.slug !== post.slug && !relatedBySlug.some((r) => r.slug === p.slug))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const related = [...relatedBySlug, ...fillers].slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: ogImage ? (ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href) : undefined,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author,
    url: "https://www.12f.dk",
    sameAs: ["https://www.12f.dk"],
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["[data-speakable]"],
  },
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(canonicalPath, Astro.site).href,
  },
  keywords: [post.data.keyword, ...(post.data.tags || [])].join(", "),
  inLanguage: "en",
  isPartOf: {
    "@type": "Blog",
    name: "Event Stories Blog",
    url: new URL("/blog/", Astro.site).href,
  },
};

// FAQPage node — only emitted when the post supplies Q&A pairs. Passed through
// BlogLayout into the shared @graph so a single JSON-LD block is kept (issue #31).
// Google requires the same Q&A text to be visible on the page (rendered below).
const faqNode =
  post.data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": `${canonicalHref}#faq`,
        mainEntity: post.data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

// HowTo node — only for posts whose frontmatter declares an ordered procedure.
// Step-based guides (timelines, checklists) were previously shipping as plain
// Article, which forfeits the how-to rich result the content already earns.
const howToNode = post.data.howTo
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "@id": `${canonicalHref}#howto`,
      name: post.data.howTo.name,
      description: post.data.howTo.description,
      ...(post.data.howTo.totalTime && { totalTime: post.data.howTo.totalTime }),
      step: post.data.howTo.steps.map((step, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: step.name,
        text: step.text,
        url: `${canonicalHref}#step-${i + 1}`,
      })),
    }
  : null;

const extraNodes = [faqNode, howToNode].filter(Boolean);
---

<BlogLayout
  title={post.data.title + " — Event Stories"}
  description={post.data.description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  articleSchema={articleSchema}
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={post.data.updatedDate ? post.data.updatedDate.toISOString() : undefined}
  author={post.data.author}
  tags={[post.data.keyword, ...(post.data.tags || [])]}
  extraNodes={extraNodes}
>
  <!--title slot-->
  <div slot="title">{post.data.title}</div>

  <!--author-meta slot-->
  <div slot="author-meta" class="flex flex-wrap items-center gap-2 text-sm text-base-content/60">
    <span>By {post.data.author}</span>
    <span aria-hidden="true"> · </span>
    <time datetime={post.data.publishDate.toISOString()}>
      {formatDate(post.data.publishDate)}
    </time>
    {post.data.updatedDate && (
      <>
        <span aria-hidden="true"> · </span>
        <span>Updated {formatDate(post.data.updatedDate)}</span>
      </>
    )}
    <span aria-hidden="true"> · </span>
    <span>{minutes} min read</span>
  </div>

  <!-- content slot -->
  {post.data.lede && (
    <p class="mt-6 text-lg leading-relaxed text-base-content/85 md:text-xl" data-speakable>
      {post.data.lede}
    </p>
  )}
  {post.data.tldr.length > 0 && (
    <div
      class="mt-8 rounded-box border border-base-300 bg-base-200/60 p-6"
      data-speakable
      aria-label="Key takeaways"
    >
      <p class="tick-label m-0 mb-3 text-base-content/50">TL;DR — Key takeaways</p>
      <ul class="m-0 list-disc space-y-2 pl-5 text-base-content/85">
        {post.data.tldr.map((point) => (
          <li class="leading-relaxed">{point}</li>
        ))}
      </ul>
    </div>
  )}
  <div class="prose prose-lg max-w-none prose-headings:font-bold prose-h2:mt-12 prose-h2:text-3xl prose-h3:text-xl prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
    <Content />
  </div>

  {post.data.faq.length > 0 && (
    <section class="mt-16" aria-labelledby="faq-heading">
      <h2
        id="faq-heading"
        class="mb-8 font-display text-3xl font-extrabold tracking-tight"
      >
        Frequently asked questions
      </h2>
      <div class="space-y-6">
        {post.data.faq.map((item) => (
          <div>
            <h3 class="mb-2 text-xl font-bold leading-snug">{item.question}</h3>
            <p class="m-0 leading-relaxed text-base-content/80">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <aside class="mt-16 rounded-box border border-base-300 bg-base-200/60 p-6 sm:p-8" aria-label="About the author">
    <p class="tick-label m-0 text-base-content/50">Written by</p>
    <p class="mb-3 mt-2 font-display text-xl font-bold tracking-tight text-base-content">
      {post.data.author}
    </p>
    <p class="m-0 leading-relaxed text-base-content/70">
      {post.data.authorBio}
    </p>
  </aside>

  {
    related.length > 0 && (
      <aside class="mt-14 border-t border-base-300 pt-12" aria-label="Keep reading">
        <h2 class="mb-8 font-display text-3xl font-extrabold tracking-tight">Keep reading</h2>
        <ul class="grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <li class="m-0 p-0">
              <a
                href={`/blog/${p.slug}/`}
                class="group flex h-full flex-col overflow-hidden rounded-box border border-base-300 bg-base-100 no-underline transition-colors hover:border-base-content/30"
              >
                {p.data.cover && (
                  <div class="overflow-hidden border-b border-base-300 bg-base-200">
                    <img
                      src={p.data.cover}
                      alt={p.data.coverAlt ?? ""}
                      width={640}
                      height={360}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <span class="font-display text-lg font-bold leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary">
                    {p.data.title}
                  </span>
                  <span class="mt-2 text-sm leading-relaxed text-base-content/70">
                    {p.data.description}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</BlogLayout>