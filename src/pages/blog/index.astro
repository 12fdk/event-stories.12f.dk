---
import { getCollection } from "astro:content";
import Layout from "Layout.astro";
import { SiteNavbar, SiteFooter } from "@components/siteChrome";
import defaultTemplateConfig from "utils/config";
import { fetchAppStoreData, fallbackAppStoreData, toAppStoreMetadata } from "utils/appStoreData";
import { readingTime } from "utils/readingTime";
import type { TemplateConfig } from "utils/configType";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const postsWithMeta = await Promise.all(
  allPosts.map(async (post) => ({
    post,
    minutes: readingTime(post.body).minutes,
  })),
);

const appStoreData = await fetchAppStoreData() ?? fallbackAppStoreData;
const config: TemplateConfig = {
  ...defaultTemplateConfig,
  logo: appStoreData.artworkUrl512.startsWith("http")
    ? appStoreData.artworkUrl512
    : defaultTemplateConfig.logo,
  appStore: toAppStoreMetadata(appStoreData),
  seo: {
    title: "Blog — Event Stories: Party Planner",
    description: "Practical guides on planning, budgeting, and running great events.",
  },
};

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout {...config}>
  <SiteNavbar client:load config={config} />
  <div class="max-w-screen-lg mx-auto px-4 py-12 md:py-20">
    <header class="mb-14 max-w-3xl">
      <p class="tick-label m-0 flex items-center gap-3 text-base-content/50">
        <span class="inline-block h-0.5 w-8 bg-primary"></span>
        Event Stories Blog
      </p>
      <h1 class="mb-4 mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tightest md:text-5xl">
        Tips and guides for planning memorable events.
      </h1>
      <p class="text-lg leading-relaxed text-base-content/70">
        Practical advice for event planners — from budgets and timelines to guest lists and day-of execution.
      </p>
    </header>

    {
      postsWithMeta.length === 0 ? (
        <p class="text-base-content/60">No posts yet — coming soon.</p>
      ) : (
        <ul class="grid list-none gap-8 p-0 md:grid-cols-2">
          {postsWithMeta.map(({ post, minutes }, index) => (
            <li class="group m-0 overflow-hidden rounded-box border border-base-300 bg-base-100 p-0 transition-colors hover:border-base-content/30">
              <a href={`/blog/${post.slug}/`} class="flex h-full flex-col">
                {post.data.cover && (
                  <div class="overflow-hidden border-b border-base-300 bg-base-200">
                    <img
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ""}
                      width={640}
                      height={360}
                      loading={index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <div class="tick-label flex flex-wrap items-center gap-x-2 gap-y-1 text-base-content/40">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{minutes} min</span>
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{tag}</span>
                      </>
                    ))}
                  </div>
                  <h2 class="mb-0 mt-3 font-display text-xl font-bold leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary sm:text-2xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-base leading-relaxed text-base-content/70">
                    {post.data.description}
                  </p>
                  <span class="tick-label mt-5 inline-block self-start border-b-2 border-primary pb-1 text-base-content">
                    Read more
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <SiteFooter client:load config={config} />
</Layout>